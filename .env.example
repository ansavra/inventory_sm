# យក Bot Token ពី @BotFather លើ Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# លេខសម្គាល់ Telegram User ID របស់អ្នកគ្រប់គ្រង (Admin)
# អាចយក ID ដោយផ្ញើសារទៅកាន់ @userinfobot
# បើមានច្រើន ប្រើសញ្ញាក្បៀស (,) ឧ. 123456789,987654321
ADMIN_USER_IDS=123456789

# ====== ជម្រើសទី ១៖ SQLite ក្នុងម៉ាស៊ីន (លំនាំដើម) ======
DATABASE_PATH=inventory.db

# ====== ជម្រើសទី ២៖ Supabase / PostgreSQL (ណែនាំ — ប្រើរួមគ្នាទាំង Local និង Vercel) ======
# យកពី Supabase Dashboard > Project Settings > Database > Connection string > URI
# សូមប្រើ "Transaction pooler" (port 6543) សម្រាប់ Vercel
# ឧ. postgresql://postgres.ugvtjiggjrtswlzizqmk:YOUR-PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Schema ក្នុង Supabase (លំនាំដើម sm — ដាច់ពីតារាងផ្សេងក្នុង project ដដែល)
DB_SCHEMA=sm

# តំបន់ម៉ោង
APP_TZ=Asia/Phnom_Penh

# លេខសម្ងាត់សម្រាប់ Telegram Webhook (បង្កើតជាអក្សរចៃដន្យវែងៗ)
TELEGRAM_WEBHOOK_SECRET=

# (ស្រេចចិត្ត) Telegram Group ឬ Channel ID សម្រាប់ទទួល Alert ស្វ័យប្រវត្តិ
# ឧទាហរណ៍៖ -1001234567890 (បើមិនដាក់ ប្រព័ន្ធនឹងផ្ញើទៅ Admin IDs ដោយផ្ទាល់)
TELEGRAM_ALERT_CHAT_ID=

# (ស្រេចចិត្ត) Google Sheets Webhook URL ពី Google Apps Script
GOOGLE_SHEET_WEBHOOK_URL=
