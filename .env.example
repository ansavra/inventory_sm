# យក Bot Token ពី @BotFather លើ Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# លេខសម្គាល់ Telegram User ID របស់អ្នកគ្រប់គ្រង (Admin)
# អាចយក ID ដោយផ្ញើសារទៅកាន់ @userinfobot
# បើមានច្រើន ប្រើសញ្ញាក្បៀស (,) ឧ. 123456789,987654321
ADMIN_USER_IDS=123456789

# ផ្លូវទៅកាន់ឯកសារ Database SQLite (ទុកតាមលំនាំដើមក៏បាន)
# លើ Render/Cloud ដែលមាន Persistent Disk សូមប្រើ៖ DATABASE_PATH=/data/inventory.db
DATABASE_PATH=inventory.db

# (ស្រេចចិត្ត) Telegram Group ឬ Channel ID សម្រាប់ទទួល Alert ស្វ័យប្រវត្តិ
# ឧទាហរណ៍៖ -1001234567890 (បើមិនដាក់ ប្រព័ន្ធនឹងផ្ញើទៅ Admin IDs ដោយផ្ទាល់)
TELEGRAM_ALERT_CHAT_ID=

# (ស្រេចចិត្ត) Google Sheets Webhook URL ពី Google Apps Script
GOOGLE_SHEET_WEBHOOK_URL=
